# Samtagon Studios Environment Variables
# Copy this file to .env and insert your API key:
# cp .env.example .env

# OpenRouter API Key for Neural Vector Embeddings & Similarity Matching
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Vector Embedding Model
# Recommended models:
# - openai/text-embedding-3-small (Fast, high-fidelity 1536-D embeddings)
# - baai/bge-m3 (Free/low-cost multilingual embedding)
# - google/embedding-001 (Google PaLM/Gemini embedding)
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
